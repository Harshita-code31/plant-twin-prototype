  m_Name: 
  m_EditorClassIdentifier: Assembly-CSharp::FireSafetyLessonExhibit
  exhibitId: fire_triangle
  title: The Fire Triangle
  content: 'Fire needs three things: Heat, Fuel and Oxygen. Remove any one and the
    fire goes out - that is how extinguishers work (cooling, starving or smothering).'
